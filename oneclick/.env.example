# One Click environment variables. Copy to .env.local for development.
# NEVER commit real values. Production values live in the hosting provider's secret store.

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode: shows sample customer + admin dashboards without real accounts.
# Ignored (forced off) when NODE_ENV=production.
ONECLICK_DEMO_MODE=true

# --- Database: Supabase (setup guide: docs/SETUP_DATABASE_EMAIL.md) ---
# Run supabase/migrations/20261004000000_server_store.sql in the Supabase SQL editor first.
# Production sign-in needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY + LICENSING_SECRET; without them it stays locked.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=        # server only (legacy service_role JWT or new sb_secret_… key). Never expose to the browser.

# --- Payment provider — NOT YET SELECTED (owner is consulting her bank in Oman) ---
# PAYMENT_PROVIDER=none
# PAYMENT_API_KEY=
# PAYMENT_WEBHOOK_SECRET=

# --- Transactional email: Resend (sign-in codes, purchase and security emails) ---
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_…
# EMAIL_FROM="One Click <hello@your-domain>"   # or "One Click <onboarding@resend.dev>" to test (sends only to the Resend account email)
# EMAIL_REPLY_TO=
# OWNER_NOTIFICATION_EMAIL=

# --- Analytics — NOT YET CONNECTED (privacy-first provider to be chosen) ---
# NEXT_PUBLIC_ANALYTICS_PROVIDER=none

# --- Licensing & access engine ---
# Required in production: 32+ random characters, server only (signs sessions and download links).
# LICENSING_SECRET=
# Site owner: comma-separated emails. Signing in with one of them gives the admin panel and
# opens every product without buying it (sandbox default: owner@example.com).
# Set the real address only here or in the hosting settings, never in the code.
# ONECLICK_OWNER_EMAILS=
# Extra staff: comma-separated emails that get the admin role only (no free products).
# ONECLICK_ADMIN_EMAILS=

# "Continue with Google / Apple" (optional; each button appears only when its values are set).
# Callback URLs to register: https://<site>/api/auth/google/callback and https://<site>/api/auth/apple/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
