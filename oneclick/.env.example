# One Click environment variables. Copy to .env.local for development.
# NEVER commit real values. Production values live in the hosting provider's secret store.

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode: shows sample customer + admin dashboards without real accounts.
# Ignored (forced off) when NODE_ENV=production.
ONECLICK_DEMO_MODE=true

# --- Supabase (database, auth, storage) — NOT YET CONNECTED ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # server only, never expose to the browser

# --- Payment provider — NOT YET SELECTED (owner is consulting her bank in Oman) ---
# PAYMENT_PROVIDER=none
# PAYMENT_API_KEY=
# PAYMENT_WEBHOOK_SECRET=

# --- Transactional email — NOT YET CONNECTED ---
# EMAIL_PROVIDER=none
# EMAIL_FROM="One Click <hello@example.com>"
# OWNER_NOTIFICATION_EMAIL=

# --- Analytics — NOT YET CONNECTED (privacy-first provider to be chosen) ---
# NEXT_PUBLIC_ANALYTICS_PROVIDER=none
