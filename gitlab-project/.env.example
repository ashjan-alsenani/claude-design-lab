# Copy to .env for local development (.env is git-ignored). In OpenShift these come from
# openshift/configmap.yaml (settings) and a Secret (the values marked SECRET). Never commit real values.

# --- Server
NODE_ENV=development
PORT=8080
# Path the app is served under. Must start and end with "/".
BASE_PATH=/employee-directory/
# Address users open, without a trailing slash. https:// is required in production.
PUBLIC_URL=http://127.0.0.1:8080

# --- Database (PostgreSQL 14 or newer)
# SECRET
DATABASE_URL=postgres://directory:change-me@127.0.0.1:5432/directory
# disable | require | verify  (verify checks the server certificate; use it in production if your database has TLS)
DATABASE_SSL=disable

# --- Sessions
# SECRET: at least 32 random characters, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=10

# --- Sign-in
# oidc = company identity provider (production). dev = type any email (local development only; refused in production).
AUTH_MODE=dev
# Company identity provider (OpenID Connect). For Microsoft Entra ID:
#   OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
# Register the redirect URI  <PUBLIC_URL><BASE_PATH>auth/callback  with the provider.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
# SECRET
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# Claim holding the user's email (Entra ID often uses preferred_username).
OIDC_EMAIL_CLAIM=email
OIDC_NAME_CLAIM=name
# Optional: only members of these groups may sign in (comma-separated, matched against OIDC_GROUPS_CLAIM).
OIDC_ALLOWED_GROUPS=
OIDC_GROUPS_CLAIM=groups

# --- Access
# Company emails that are always administrators (the first administrator must be here). Comma-separated.
ADMIN_EMAILS=admin@example.com
# A signed-in account that isn't in Users & access: none = blocked (recommended), viewer = read-only access.
DEFAULT_ROLE=none

# --- First start
# What an empty database starts with: empty (production) or sample (fictional data, for demos and staging).
INITIAL_DATA=sample

LOG_LEVEL=info
