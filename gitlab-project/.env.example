# Copy to .env for local use (".env" is git-ignored). In GitLab, set these as CI/CD variables instead.
# Nothing here is needed to view the site; they configure the built-in owner (administrator) account and the footer.

# Owner account: the one fixed administrator who can create other accounts.
# OWNER_USERNAME is what the owner types to sign in (an employee ID works well).
OWNER_USERNAME=
# Optional extra usernames that also sign in as the owner, comma-separated.
OWNER_LOGIN_ALIASES=
# Name shown in the top bar and activity log for the owner.
OWNER_DISPLAY_NAME=
# SHA-256 of the owner's password. Generate it with:  npm run hash-password
# Store it as a masked, protected CI/CD variable. It ends up in config.js in the browser, so choose a long password
# (see docs/HANDOVER.md, blocker B3).
OWNER_PASSWORD_SHA256=

# Footer credit ("Created by …"). Leave CREDIT_NAME empty to hide the footer line.
CREDIT_NAME=
CREDIT_TEAM=

# Local server (npm run serve / npm start)
PORT=8080
HOST=127.0.0.1
BASE_PATH=/employee-directory/

# Set to true in CI for production builds so a build without owner settings fails instead of shipping.
REQUIRE_OWNER=false
